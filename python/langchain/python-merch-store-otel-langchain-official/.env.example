# --- LLM for the agent (Claude) ---
ANTHROPIC_API_KEY=your-key-here

# --- Redis Agent Memory Server (memory backend) ---
# AMS uses OpenAI for embeddings + fact extraction, even though the agent talks to Claude.
OPENAI_API_KEY=your-openai-key-here
AGENT_MEMORY_URL=http://localhost:8000
# Cross-session identity: a new chat with the same user_id still recalls past preferences.
DEFAULT_USER_ID=merch-shopper
AGENT_MEMORY_NAMESPACE=merch-store

# OpenTelemetry / Dash0 configuration
OTEL_SERVICE_NAME=python-merch-store
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingress.eu-west-1.aws.dash0.com
OTEL_EXPORTER_OTLP_HEADERS_AUTHORIZATION=your-dash0-auth-token
DASH0_DATASET=default
